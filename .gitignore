# ==============================================================================
# Git Ignore Configuration for 6G VANET Intrusion Detection
# ==============================================================================

# 1. Large Raw Dataset CSV Files (1.5GB total, individual files > 100MB exceed GitHub limits)
/*.csv
train_*.csv
val_*.csv
test_*.csv
test_hard_*.csv

# 2. Large Preprocessed Window Cache (.npz and temporary window dumps > 100MB)
work/cache/
work/cache_v2/
*.npz

# 3. Intermediate Training Epoch Checkpoints (~100MB total)
# (Preserves lightweight 'best_*.pt' weights (~900KB) and scaler .pkl files)
work/checkpoints/*_epoch_*.pt
work/checkpoints_v2/*_epoch_*.pt
checkpoints/*_epoch_*.pt

# 4. Python Environment & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 5. Jupyter Notebook Checkpoints
.ipynb_checkpoints

# 6. IDEs and OS Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

